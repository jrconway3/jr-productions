{
  "name": "jaidynreiman-net",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-nav-categories.mjs && next dev",
    "build": "git submodule update --remote --merge && node scripts/generate-nav-categories.mjs && next build",
    "start": "next start",
    "generate:fe:add": "node scripts/generate-fe-assets.mjs --mode=add-new",
    "generate:fe:rebuild": "node scripts/generate-fe-assets.mjs --mode=rebuild",
    "generate:lpc:add": "node scripts/generate-lpc-assets.mjs --mode=add-new",
    "generate:lpc:rebuild": "node scripts/generate-lpc-assets.mjs --mode=rebuild",
    "generate:lpc:clear-new": "node scripts/generate-lpc-assets.mjs --clear-new",
    "generate:nav:categories": "node scripts/generate-nav-categories.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "framer-motion": "^12.26.2",
    "jszip": "^3.10.1",
    "next": "^16.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.0",
    "@tailwindcss/forms": "^0.5.4",
    "@tailwindcss/typography": "^0.5.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jszip": "^3.4.0",
    "@types/node": "20.19.27",
    "@types/react": "18.3.27",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.14",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^3.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.5"
  }
}
